# /etc/gec-fe2026/dashboard.env (CT129) — sem segredos; a chave API fica em formbricks.env
FE2026_DB=/var/lib/gec-fe2026/fe2026.db
FE2026_ENV_FILE=/etc/gec-fe2026/formbricks.env
# auto: cookie Secure quando o pedido chega por HTTPS (túnel); 1 força, 0 desliga
FE2026_COOKIE_SECURE=auto
# 1 mostra NIF e nº de documento às empresas (ponto 3 da especificação: por omissão, não)
FE2026_RH_VE_DOCUMENTOS=0
FE2026_BASE_URL=https://dashboard.exemplo.org
